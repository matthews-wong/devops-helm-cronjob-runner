{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "schedule", "concurrencyPolicy", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "schedule": { "type": "string", "minLength": 9 },
    "concurrencyPolicy": { "enum": ["Allow", "Forbid", "Replace"] },
    "job": {
      "type": "object",
      "properties": {
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"]
    }
  }
}
